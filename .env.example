# Copy to .env. All paths are relative to this project unless absolute.
HELPDESK_DATA_DIR=data/college
HELPDESK_STATE_DIR=.runtime/college
OLLAMA_API_BASE=http://127.0.0.1:11434
HELPDESK_MODEL=qwen3:8b
HELPDESK_EMBED_MODEL=nomic-embed-text
HELPDESK_SEMESTER=2026-27-I
HELPDESK_PROGRAMME=B.Tech
HELPDESK_COHORT=2023
HELPDESK_BRANCH=Artificial Intelligence and Data Science
HELPDESK_TEMPERATURE=0
HELPDESK_CONTEXT=8192
HELPDESK_TIMEOUT=180
HELPDESK_VERIFY=true
# Qwen3 reasoning is disabled for predictable response times.
HELPDESK_THINK=false
